# انسخ هذا الملف إلى .env وعدّل القيم
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://business:CHANGE_ME@127.0.0.1:3306/routini_business"

NODE_ENV=production
HOST=127.0.0.1
PORT=3100

# رابط الموقع العام (يُستخدم بروابط الدعوات). مثال: https://app.example.com
PUBLIC_URL=

# مالكو المنصة (يشوفون قائمة الشركات ويوقفونها) — بريدات مفصولة بفاصلة
PLATFORM_ADMINS=

# false = إغلاق تسجيل الشركات الجديدة (الدعوات والشركات الحالية تبقى تشتغل)
ALLOW_COMPANY_SIGNUP=true

# إشعارات الهاتف (Web Push): المفاتيح من البيئة. مطلوبة بالإنتاج والسيرفر يوقف إذا ناقصة.
# ولّدها مرة وحدة (مثلاً: npx web-push generate-vapid-keys) وخلّها بمخزن الأسرار، لا ترفعها بـ git.
# إذا اكو مفاتيح قديمة شغالة انقلها هنا بدل ما تولّد جديدة، حتى ما تنكسر الاشتراكات الموجودة.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: أو رابط https للتواصل (مطلوب بالإنتاج)
VAPID_SUBJECT=
# للتطوير بس: مسار ملف مفاتيح يتولّد تلقائياً بصلاحية 600 (يفضّل خارج مجلد المشروع)
# VAPID_FILE=

